# XpressTend — operator configuration
#
# Nothing in this file is a value. It is the list of names the running service
# reads, with what each one is and where it comes from. Real values are secrets
# and never live in the repository: set them with `wrangler secret put <NAME>`
# from the api/ directory, which stores them encrypted against the Worker and
# keeps them out of wrangler.toml, out of the client bundle and out of git.
#
# Copy this file to .env for local reference only. It is git-ignored; if it is
# not, stop and fix that before putting a real value anywhere near it.


# ─── Payment rail selection ───────────────────────────────────────────────────
#
# Which rail moves the money, by id (see api/src/rails/index.ts).
# Leave unset and no rail is active: transfers keep the existing test-mode path
# and nothing is sent to a provider. There is deliberately no automatic
# fallback to "whichever rail happens to be configured" — which provider takes
# a customer's money is an operator decision, not a default.
PAYMENT_RAIL=mobile_money


# ─── Mobile money ─────────────────────────────────────────────────────────────
#
# Credentials for the mobile-money provider whose protocol this rail
# implements. Obtain all of the following from that provider when your merchant
# account is created.
#
# They are merchant credentials: anyone holding them can transact as
# XpressTend, so they belong in `wrangler secret put` and nowhere else. The
# client never receives them — every call that needs them is made server-side
# in api/src/rails/mobile-money.ts.
#
#   MOBILE_MONEY_MERCHANT_UID   Merchant UID issued by the provider
#   MOBILE_MONEY_API_USER_ID    API user id issued by the provider
#   MOBILE_MONEY_API_KEY        API key issued by the provider
#
# Ask for a staging set first. Verify the whole flow against staging — it does
# not move real money — before a production credential is ever installed.
MOBILE_MONEY_MERCHANT_UID=
MOBILE_MONEY_API_USER_ID=
MOBILE_MONEY_API_KEY=

# STAGE or PROD. Defaults to STAGE when unset, which is the safe direction:
# a missing value must never mean "live".
MOBILE_MONEY_ENVIRONMENT=STAGE

# Endpoints, one per environment, taken from the provider's own documentation.
#
# Neither has a default, on purpose. A hardcoded host would be an address this
# repository asserts is correct, and keeping the two separate is what stops a
# production credential posting at a sandbox. With the one matching
# MOBILE_MONEY_ENVIRONMENT unset, the rail reports itself unconfigured and no
# transfer is attempted.
#
# [NEEDS PROVIDER API] The production endpoint is not stated in the published
# client libraries — they point their production branch at the staging host,
# which is a defect rather than an address. Ask the provider for it directly.
MOBILE_MONEY_STAGE_BASE_URL=
MOBILE_MONEY_PROD_BASE_URL=


# ─── Existing service configuration ───────────────────────────────────────────
# Listed for completeness; see api/src/env.ts for what each one does.
SESSION_PEPPER=
ADMIN_BOOTSTRAP_SECRET=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
